# .valgrind.supp - Valgrind suppressions for pg_vault_tde
#
# Suppress known false positives from OpenSSL 3.x and libcurl that are
# not related to our code.  These are well-documented upstream issues.

# OpenSSL 3.x PRNG initialization (one-time allocation, not a leak)
{
   openssl_prng_init
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:RAND_poll
   ...
}

# OpenSSL EVP cipher context error-path cleanup (upstream known)
#
# SCOPING MATTERS HERE.  This entry used to read
#     Memcheck:Cond / ... / fun:EVP_CIPHER_CTX_free / ...
# with bare wildcards on both sides and no object constraint, which suppresses
# a conditional-on-uninitialised error *anywhere* a stack passes through that
# frame — including one raised inside our own tde_gcm_encrypt/decrypt cleanup,
# which is exactly the bug class this file is supposed to leave visible.
#
# The form below requires the error to occur INSIDE libcrypto (innermost frame
# is an obj: match) with EVP_CIPHER_CTX_free somewhere up the stack.  An
# uninitialised value originating in pg_vault_tde still reports.
{
   openssl_evp_ctx_free
   Memcheck:Cond
   obj:*/libcrypto.so*
   ...
   fun:EVP_CIPHER_CTX_free
}

# libcurl SSL context setup (one-time per handle)
{
   curl_ssl_ctx
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:curl_easy_init
   ...
}

# PostgreSQL palloc arena: we use PostgreSQL's allocator, not malloc.
# Valgrind sees palloc'd memory as "still reachable" at exit, which is
# correct: PostgreSQL does not free MemoryContexts on normal shutdown.
{
   pg_palloc_arena
   Memcheck:Leak
   match-leak-kinds: reachable
   ...
   fun:AllocSetAlloc
   ...
}
